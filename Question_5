#include <stdio.h>
int main() {
    int time, motion, lightLevel;
    int room, cooking;
    printf("Enter time (0-23): ");
    scanf("%d", &time);
    printf("Enter motion detected (1 = Yes, 0 = No): ");
    scanf("%d", &motion);
    printf("Enter light level (0-100): ");
    scanf("%d", &lightLevel);
    printf("\nSelect Room:\n");
    printf("1. Living Room\n");
    printf("2. Bedroom\n");
    printf("3. Kitchen\n");
    printf("Enter your choice: ");
    scanf("%d", &room);
    switch (room) {
        case 1:
            printf("\nRoom: Living Room\n");
            if (motion == 0) {
                printf("Mode: Away mode\n");
                printf("Action: All OFF\n");
            }
            else if (time >= 6 && time < 18) {
                printf("Mode: Day mode\n");
                printf("Action: Lights ON\n");
            }
            else if (time >= 18 && time < 23) {
                printf("Mode: Evening mode\n");
                printf("Action: Dim lights\n");
            }
            else {
                printf("Mode: Night mode\n");
                printf("Action: Lights OFF\n");
            }
            break;
        case 2:
            printf("\nRoom: Bedroom\n");
            if (motion == 0) {
                printf("Mode: Away mode\n");
                printf("Action: All OFF\n");
            }
            else if (time >= 6 && time < 18) {
                printf("Mode: Day mode\n");
                printf("Action: Lights ON\n");
            }
            else if (time >= 18 && time < 23) {
                printf("Mode: Evening mode\n");
                printf("Action: Dim lights\n");
            }
            else {
                printf("Mode: Night mode\n");
                printf("Action: Lights OFF\n");
            }
            break;
        case 3:
            printf("\nRoom: Kitchen\n");
            printf("Are you cooking? (1 = Yes, 0 = No): ");
            scanf("%d", &cooking);
            if (motion == 0) {
                printf("Mode: Away mode\n");
                printf("Action: All OFF\n");
            }
            else if (time >= 6 && time < 18) {
                printf("Mode: Day mode\n");
                printf("Action: Lights ON\n");
            }
            else if (time >= 18 && time < 23) {
                printf("Mode: Evening mode\n");
                printf("Action: Dim lights\n");
            }
            else {
                printf("Mode: Night mode\n");
                printf("Action: Lights OFF\n");
            }
            if (cooking == 1) {
                printf("Kitchen Action: Exhaust fan ON\n");
            }
            break;
        default:
            printf("Invalid room choice.\n");
    }
    return 0;
}
